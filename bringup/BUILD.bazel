cc_library(
    name = "tasks",
    hdrs = [
        "blink.h",
        "can_rx.h",
        "can_tx.h",
        "dac_demo.h",
        "flash_target.h",
        "monitor_imu.h",
        "monitor_power.h",
        "process_messages.h",
        "quit.h",
        "random_blink.h",
        "read_board_id.h",
        "watchdog.h",
    ],
    deps = [
        "//flags",
        "//hal",
        "//hal/board",
        "//hal/board_identification",
        "//hal/can_bus",
        "//hal/gpio",
        "//hal/led",
        "//hal/power_monitor",
        "//hal/programmer",
        "//meta:build_time",
        "//meta:firmware",
        "//meta:flash",
        "//platforms",
        "//random",
        "//serial_wire",
        "//system",
        "//time:embedded_clock",
    ],
)

cc_binary(
    name = "blink",
    srcs = [
        "blink.cc",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":tasks",
        "//base",
        "//hal",
        "//hal/board",
        "//hal/gpio",
        "//profile",
        "//system",
        "//time:embedded_clock",
    ],
)

