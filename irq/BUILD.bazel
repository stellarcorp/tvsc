cc_library(
    name = "irq",
    hdrs = [
        "irq.h",
    ],
    visibility = ["//visibility:public"],
    deps = select({
        "//platforms:stm32_core": [
            ":irq_arm",
        ],
        "@platforms//os:linux": [
            ":irq_noop",
        ],
        "//conditions:default": [
        ],
    }),
)

cc_library(
    name = "irq_arm",
    hdrs = ["irq_arm.h"],
    target_compatible_with = [
        "@platforms//cpu:armv7e-mf",
        "@platforms//os:none",
    ],
)

cc_library(
    name = "irq_noop",
    hdrs = ["irq_noop.h"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)
