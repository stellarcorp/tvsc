cc_binary(
    name = "blink_systick.elf",
    srcs = [
        "blink_systick.cc",
    ],
    additional_linker_inputs = [
        "//platforms:linker_script",
    ],
    linkopts = ["-Wl,-T$(execpath //platforms:linker_script)"],
    target_compatible_with = select({
        "@platforms//os:none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//base",
        "//hal2",
        "//hal2/board",
        "//hal2/config",
        "//hal2/gpio",
        "//meta:build_time",
        "//platforms:startup",
    ],
)

