licenses(["notice"])

cc_library(
    name = "stm32_headers",
    hdrs = [
        "stm32.h",
        "stm32_hal.h",
    ],
)

cc_library(
    name = "stm32",
    srcs = [
        "syscalls.c",
        "sysmem.c",
        "system_stm32l4xx.c",
    ],
    target_compatible_with = select({
        "//platforms:stm32_core": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":stm32_headers",
        "@com_github_stellarcorp_stm32_libraries//STM32Cube_FW_L4:nucleo_l452xx_hal",
    ],
    alwayslink = True,
)

cc_library(
    name = "stm32_no_dynamic_allocation",
    srcs = [
        "syscalls.c",
        "sysmem_noheap.c",
        "system_stm32l4xx.c",
    ],
    target_compatible_with = select({
        "//platforms:stm32_core": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":stm32_headers",
        "@com_github_stellarcorp_stm32_libraries//STM32Cube_FW_L4:nucleo_l452xx_hal",
    ],
    alwayslink = True,
)
