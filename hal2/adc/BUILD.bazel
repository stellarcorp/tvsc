cc_library(
    name = "adc_headers",
    hdrs = [
        "adc.h",
    ],
    deps = [
        "//buffer",
        "//hal2/gpio",
    ],
)

cc_library(
    name = "adc",
    target_compatible_with = select({
        "//platforms:stm32l4xx_adc": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":adc_headers",
        "//hal2",
    ] + select({
        "//platforms:stm32l4xx_adc": [
            ":stm32l4_adc",
        ],
    }),
)

cc_library(
    name = "stm32l4_adc",
    srcs = [
        "stm32l4_adc.cc",
    ],
    hdrs = [
        "stm32l4_adc.h",
        "stm32l4_adc_config.h",
    ],
    target_compatible_with = [
        "//platforms:stm32l4xx_adc",
    ],
    deps = [
        ":adc_headers",
        "//error",
        "//hal2",
        "//hal2/dma",
        "//hal2/gpio",
        "//hal2/timer",
        "//third_party/stm32",
    ],
)
